# =============================================================================
# CodeSentinel — environment configuration
# Copy to `.env.local` (Next.js) and fill in. NEVER commit the filled file.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Public base URL of this instance. Used for OAuth callbacks + webhook URLs.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Production / Docker: a real PostgreSQL connection string.
#   docker compose up -d db   ->  postgres://codesentinel:codesentinel@localhost:5432/codesentinel
# Leave EMPTY to fall back to an embedded PGlite database (real Postgres via
# WASM) stored in ./.data/pglite — zero-install local development.
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Session / crypto
# -----------------------------------------------------------------------------
# 32+ byte random string. Signs session cookies (JWT/JWS).
#   openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-session-secret-change-me-please-32b"

# 32-byte key, base64, used for AES-256-GCM encryption of GitHub tokens at rest.
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# GitHub OAuth App  (Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL: ${APP_URL}/api/auth/github/callback
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# GitHub App  (for webhooks, Checks API, PR comments)
# Settings -> Developer settings -> GitHub Apps.  See docs/github-app-setup.md
# -----------------------------------------------------------------------------
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
# Private key PEM. Either inline (escape newlines as \n) or a file path.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_PATH=""
# Webhook secret — must match the GitHub App config. Verifies HMAC signatures.
GITHUB_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# LLM provider (optional — AI *enhances* deterministic analysis, never replaces)
# Without a key, CodeSentinel still runs every deterministic scanner; AI
# explanation panels degrade gracefully to a disabled state.
# -----------------------------------------------------------------------------
# One of: openai | anthropic | none
LLM_PROVIDER="none"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""

# -----------------------------------------------------------------------------
# Scanning
# -----------------------------------------------------------------------------
# Optional: path to a `semgrep` binary. When absent, the Semgrep scanner is
# reported as unavailable rather than silently producing nothing.
SEMGREP_PATH=""
# Max file size (bytes) a scanner will read. Protects against huge blobs.
SCAN_MAX_FILE_BYTES="1000000"

# -----------------------------------------------------------------------------
# Scheduled scanning
# -----------------------------------------------------------------------------
# Shared secret authorising POST /api/guardian/run, the endpoint that drains the
# scan queue. Presented as `Authorization: Bearer <CRON_SECRET>` by Vercel Cron
# or any external scheduler. Leave EMPTY to disable machine access entirely —
# the endpoint then only accepts signed-in users.
#   openssl rand -hex 32
CRON_SECRET=""
